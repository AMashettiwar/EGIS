{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "cohort_filter": {
      "additionalProperties": false,
      "properties": {
        "eligibility_field": {
          "type": "string"
        },
        "eligibility_value": {},
        "project_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "study_id": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "denominator_mode": {
      "enum": [
        "left",
        "eligible",
        "universe"
      ]
    },
    "entity_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "enum": [
        "count_entities",
        "assay_availability",
        "assay_overlap",
        "file_lineage",
        "compare_inventories",
        "cohort_count",
        "claim_verification",
        "cross_source_overlap_count",
        "entity_attribute_query",
        "out_of_scope_request"
      ]
    }
  },
  "required": [
    "operation"
  ],
  "title": "Structured evidence query",
  "type": "object"
}
